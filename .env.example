# ============================================================================
#  fullstack-arr configuration
# ============================================================================

# --- Authentication ---------------------------------------------------------
# Each user logs in and sets their OWN Real-Debrid + tracker tokens in the UI.
# The first account created (via the first-run setup screen) is the OWNER/admin
# and is the only account that can add more users.
# Session lifetime (days) for the login cookie:
SESSION_TTL_DAYS=30
# Set true ONLY on a fully trusted, non-public LAN to skip login entirely.
# Never enable this behind the public cloudflared tunnel.
AUTH_DISABLED=false

# --- TV pairing (opt-in, OFF by default) ------------------------------------
# Lets a TV show a short code that you approve from a phone/browser you are
# already signed into (/api/auth/tv/*). Approving one mints a FULL session for
# your account on that TV, so it stays off unless you actually pair televisions.
# While off, those five endpoints answer 404 and clients hide the option — the
# server behaves exactly like a build without the feature. The /tv approval page
# and your device list (Account -> Devices, where a paired TV is revoked) are
# unaffected either way.
TV_PAIRING=false

# --- Real-Debrid (optional seed) -------------------------------------------
# Real-Debrid is now PER-USER (set in the app's Settings) and is REQUIRED to
# stream/download — it keeps all torrent traffic off your home IP (ISP-ban-risk
# prevention). This env value ONLY seeds the first-run owner account, if set.
# Get a token at https://real-debrid.com/apitoken  (premium subscription required)
REALDEBRID_TOKEN=

# --- Server -----------------------------------------------------------------
PORT=8787
# Public base URL, used to build Stremio addon / stream links (and the URL a TV
# prints when pairing). Must be reachable by the OTHER device: set it to your
# LAN address (http://10.0.1.5:8787) or your tunnel URL. A localhost/127.0.0.1
# value is treated as "not set" where a URL has to be handed to another device.
PUBLIC_URL=http://localhost:8787

# Which upstream hops may tell this server who a client is (CF-Connecting-IP /
# X-Forwarded-For). Everything that keys on a client address — the login
# lockout, TV-pairing limits, the "requested from" line shown when approving a
# TV — resolves it through this, so it decides what an attacker can forge.
#   unset / loopback   the default: a reverse proxy or cloudflared running on
#                      THIS host (it connects over 127.0.0.1). Correct for the
#                      standard setup, and it means a LAN client's own
#                      forwarding headers are ignored, as they must be.
#   none               nothing in front at all; use the socket peer, always.
#   <ip> or <ipv4/cidr>  a proxy on another machine, named explicitly
#                        (comma-separated for several).
# `true` is accepted as a spelling of "loopback": Express's literal `true` would
# trust every hop and let any client name itself, so it is never used.
# TRUST_PROXY=loopback

# --- Storage ----------------------------------------------------------------
# App state (json db + cached artwork).
DATA_DIR=./data
# Where downloaded anime files are organized.
LIBRARY_DIR=./library

# --- Search / quality preferences ------------------------------------------
# Preferred resolution when ranking torrents (2160 | 1080 | 720 | 480).
PREFERRED_RESOLUTION=1080
# Minimum seeders to consider a torrent viable.
MIN_SEEDERS=1
# Max concurrent Real-Debrid -> local downloads.
DOWNLOAD_CONCURRENCY=2

# --- Subtitles (optional) ---------------------------------------------------
# Jimaku = community anime subs keyed by AniList id. Get a key at https://jimaku.cc
JIMAKU_API_KEY=
OPENSUBTITLES_API_KEY=
# Comma-separated languages to keep (BCP-47-ish). Default: en
SUBTITLE_LANGS=en

# --- Jellyfin handoff (optional) -------------------------------------------
# When set, finished downloads trigger a Jellyfin library rescan.
JELLYFIN_URL=
JELLYFIN_API_KEY=

# --- Tracker connections ----------------------------------------------------
# Token priority per user: their own token (set in Settings) > these env
# overrides > the self-hosted auth site below.
#   AniList token: https://anilist.co/settings/developer  (create client, get token)
#   MAL token:     https://myanimelist.net/apiconfig
ANILIST_TOKEN=
MAL_TOKEN=

# --- Self-hosted auth site (Renzo Apps: central AniList/MAL tokens, refreshed) --
# Two bases, both have sensible defaults:
#  - AUTHSITE_URL: internal base for server-to-server token fetch (X-Service-Key).
#    Defaults to http://127.0.0.1:8788/auth so it never needs the public tunnel.
#  - AUTHSITE_PUBLIC_URL: public base the browser uses for the OAuth connect popup
#    (defaults to https://renzo-apps.levitatemedia.top/auth).
# Set AUTHSITE_SERVICE_KEY to SERVICE_KEY from /opt/zurg-stack/authsite/.env;
# blank disables the auth-site integration entirely.
# AUTHSITE_URL=http://127.0.0.1:8788/auth
# AUTHSITE_PUBLIC_URL=https://renzo-apps.levitatemedia.top/auth
AUTHSITE_SERVICE_KEY=

# --- Auto-downloader --------------------------------------------------------
# Watches titles flagged "Auto" (and your AniList CURRENT list, when connected)
# and queues new aired episodes automatically.
AUTO_DOWNLOAD=false
AUTO_DOWNLOAD_INTERVAL_MIN=60
# Safety cap: max episodes queued per pass (big backlogs drain gradually).
AUTO_DOWNLOAD_MAX_PER_TICK=6

# --- Optional: TMDB (fallback artwork for movies) --------------------------
TMDB_API_KEY=

# Renzo Jellyfin plugin: shared key the plugin uses to reach the catalog/stream API
RENZO_PLUGIN_KEY=
